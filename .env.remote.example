# Local API/web processes using Oracle data through the SSH tunnel documented in
# docs/oracle-deployment.md. No PostgreSQL or artifact files are stored locally.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://psx:replace-with-url-encoded-password@127.0.0.1:15432/psx_ai_dev
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=2
JWT_SECRET_KEY=use-the-same-value-as-oracle-for-a-compatible-dev-clone
ENCRYPTION_KEY=use-a-separate-dev-key-after-removing-cloned-llm-keys
ENABLE_DEMO_ACCESS=false
AUTO_CREATE_TABLES=false
MARKET_DATA_MODE=auto
MARKET_HISTORY_BOOTSTRAP_ENABLED=false
SCHEDULED_RESEARCH_ENABLED=false
MACRO_INGESTION_ENABLED=false
EVIDENCE_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:16379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/3
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_ENDPOINT_URL=http://127.0.0.1:19000
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=psx-artifacts
ARTIFACT_S3_ACCESS_KEY=replace-with-minio-access-key
ARTIFACT_S3_SECRET_KEY=replace-with-minio-secret-key
ARTIFACT_S3_ADDRESSING_STYLE=path
EVIDENCE_SPOOL_ROOT=/tmp/psx-evidence-spool
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_BASE_URL=http://127.0.0.1:8000
