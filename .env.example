# Shared
APP_ENV=local

# Backend
ENABLE_DEMO_ACCESS=false
DEMO_ACCESS_TOKEN=
DEMO_ACCESS_EMAIL=portfolio.manager@example.com
DATABASE_URL=postgresql+psycopg://psx:psx@localhost:5433/psx_ai
DATABASE_POOL_SIZE=24
DATABASE_MAX_OVERFLOW=8
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=replace-with-fernet-key-run-python--m-app.core.keys
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_MODE=auto
MARKET_DATA_REFRESH_SECONDS=300
MARKET_HISTORY_YEARS=5
MARKET_HISTORY_BOOTSTRAP_ENABLED=true
SCHEDULED_RESEARCH_ENABLED=true
RESEARCH_REPORT_LIMIT_PER_RUN=20
SOURCE_ARTIFACT_ROOT=./data/artifacts
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EVIDENCE_ENABLED=false
EVIDENCE_SCHEDULER_SECONDS=30
EVIDENCE_DISCOVERY_QUEUE_TARGET=20
EVIDENCE_FETCH_QUEUE_TARGET=80
EVIDENCE_PARSE_QUEUE_TARGET=80
EVIDENCE_INDEX_QUEUE_TARGET=40
EVIDENCE_HISTORICAL_QUEUE_TARGET=10
EVIDENCE_STAGE_LEASE_SECONDS=900
EVIDENCE_MAX_RETRIES=3
EVIDENCE_RETRY_BACKOFF_SECONDS=60
EVIDENCE_CIRCUIT_FAILURE_THRESHOLD=5
EVIDENCE_CIRCUIT_OPEN_SECONDS=900
EVIDENCE_CANDIDATE_RETENTION_DAYS=45
EVIDENCE_SPOOL_RETENTION_HOURS=24
SCREENING_COMPLETENESS_THRESHOLD=0.70
SCREENING_PROMOTION_PERCENTILE=0.82
EMBEDDING_DIMENSIONS=384
ASSISTANT_MAX_TOOL_ITERATIONS=12
ASSISTANT_MAX_TOOL_COST_UNITS=18
ASSISTANT_MAX_RETRIEVED_CHUNKS=8
ASSISTANT_TIMEOUT_SECONDS=30

# Frontend
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Provider placeholders. Users normally save BYOK keys in-app.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
