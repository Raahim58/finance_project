# Shared
APP_ENV=local

# Backend
ENABLE_DEMO_ACCESS=false
DEMO_ACCESS_TOKEN=
DEMO_ACCESS_EMAIL=portfolio.manager@example.com
DATABASE_URL=postgresql+psycopg://psx:psx@localhost:5433/psx_ai
DATABASE_POOL_SIZE=24
DATABASE_MAX_OVERFLOW=8
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=replace-with-fernet-key-run-python--m-app.core.keys
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_MODE=auto
MARKET_DATA_REFRESH_SECONDS=300
MARKET_HISTORY_YEARS=5
MARKET_HISTORY_BOOTSTRAP_ENABLED=true
SCHEDULED_RESEARCH_ENABLED=true
MACRO_INGESTION_ENABLED=false
MACRO_SCHEDULER_SECONDS=30
MACRO_QUEUE_TARGET=8
MACRO_HISTORY_START_YEAR=2000
FRED_API_KEY=
EIA_API_KEY=
RESEARCH_REPORT_LIMIT_PER_RUN=20
SOURCE_ARTIFACT_ROOT=./data/artifacts
ARTIFACT_STORAGE_BACKEND=local
# For Oracle/MinIO use s3, with the endpoint reached through Docker DNS remotely
# or an SSH tunnel locally (for example http://127.0.0.1:19000).
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=psx-artifacts
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
ARTIFACT_S3_ADDRESSING_STYLE=path
EVIDENCE_SPOOL_ROOT=./data/evidence-spool
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EVIDENCE_ENABLED=false
EVIDENCE_SCHEDULER_SECONDS=30
EVIDENCE_DISCOVERY_QUEUE_TARGET=20
EVIDENCE_FETCH_QUEUE_TARGET=80
EVIDENCE_PARSE_QUEUE_TARGET=80
EVIDENCE_INDEX_QUEUE_TARGET=40
EVIDENCE_HISTORICAL_QUEUE_TARGET=10
EVIDENCE_HISTORICAL_BATCH_CANDIDATES=25
EVIDENCE_HISTORICAL_FETCH_BUDGET=100
EVIDENCE_HISTORICAL_STORAGE_BUDGET_MB=250
EVIDENCE_HISTORICAL_LIVE_BACKLOG_RESERVE=1
EVIDENCE_HISTORICAL_EXPANSION_HEALTHY_DAYS=7
EVIDENCE_STAGE_LEASE_SECONDS=900
EVIDENCE_MAX_RETRIES=3
EVIDENCE_RETRY_BACKOFF_SECONDS=60
EVIDENCE_CIRCUIT_FAILURE_THRESHOLD=5
EVIDENCE_CIRCUIT_OPEN_SECONDS=900
EVIDENCE_CANDIDATE_RETENTION_DAYS=45
EVIDENCE_SPOOL_RETENTION_HOURS=24
EVIDENCE_PASS4_OFFICIAL_ENABLED=false
EVIDENCE_PASS4_BREADTH_ENABLED=false
EVIDENCE_CANARY_DISCOVERY_DAILY=2000
EVIDENCE_CANARY_FETCH_DAILY=250
EVIDENCE_CANARY_SELECTED_DAILY=75
EVIDENCE_CANARY_STORAGE_DAILY_MB=1536
EVIDENCE_CANARY_STORAGE_SEVEN_DAY_MB=10240
EVIDENCE_CANARY_FETCH_READY_TARGET=120
EVIDENCE_CONTACT_EMAIL=evidence-ops@example.invalid
EVIDENCE_SEC_EDGAR_CIKS=
SCREENING_COMPLETENESS_THRESHOLD=0.70
SCREENING_PROMOTION_PERCENTILE=0.82
EMBEDDING_DIMENSIONS=384
ASSISTANT_MAX_TOOL_ITERATIONS=12
ASSISTANT_MAX_TOOL_COST_UNITS=18
ASSISTANT_MAX_RETRIEVED_CHUNKS=8
ASSISTANT_TIMEOUT_SECONDS=30
ASSISTANT_EXECUTION_DEADLINE_SECONDS=300
ASSISTANT_EXECUTION_INPUT_TOKEN_LIMIT=200000

# Frontend
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Provider placeholders. Users normally save BYOK keys in-app.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_INDEX_VERSION=2
PHASE8_REASONING_ENABLED=true
PHASE8_MARKET_DEEP_CANDIDATE_LIMIT=8
PHASE8_SECTOR_CANDIDATE_LIMIT=3
PHASE8_TARGETED_DEADLINE_SECONDS=120
PHASE8_SIZING_DEADLINE_SECONDS=180
PHASE8_MARKET_DEADLINE_SECONDS=300
PHASE8_DIAGNOSTIC_PAYLOAD_BYTES=1073741824
# Optional estimated-cost metadata. Values are per one million tokens and are
# distinct from actual provider billing.
PHASE8_PRICING_VERSION=
PHASE8_PRICING_JSON={}
