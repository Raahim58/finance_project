APP_ENV=production
POSTGRES_DB=psx_ai
POSTGRES_USER=psx
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://psx:replace-with-url-encoded-password@postgres:5432/psx_ai
DATABASE_POOL_SIZE=12
DATABASE_MAX_OVERFLOW=4
JWT_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-fernet-key-run-python--m-app.core.keys
ENABLE_DEMO_ACCESS=false
ALLOW_MOCK_IN_PRODUCTION=false
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_MODE=auto
MARKET_HISTORY_BOOTSTRAP_ENABLED=false
SCHEDULED_RESEARCH_ENABLED=false
MACRO_INGESTION_ENABLED=false
EVIDENCE_ENABLED=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_ENDPOINT_URL=http://minio:9000
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=psx-artifacts
ARTIFACT_S3_ACCESS_KEY=replace-with-minio-access-key
ARTIFACT_S3_SECRET_KEY=replace-with-minio-secret-key
ARTIFACT_S3_ADDRESSING_STYLE=path
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key
EVIDENCE_SPOOL_ROOT=/data/evidence-spool
API_INTERNAL_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
