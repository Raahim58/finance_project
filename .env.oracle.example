APP_ENV=production
POSTGRES_DB=psx_ai
POSTGRES_USER=psx
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://psx:replace-with-url-encoded-password@postgres:5432/psx_ai
DATABASE_POOL_SIZE=12
DATABASE_MAX_OVERFLOW=4
JWT_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-fernet-key-run-python--m-app.core.keys
# The live host currently runs with demo access true; keep false unless you need the demo login.
ENABLE_DEMO_ACCESS=false
DEMO_ACCESS_EMAIL=portfolio.manager@example.com
ALLOW_MOCK_IN_PRODUCTION=false
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_MODE=dps
MARKET_HISTORY_BOOTSTRAP_ENABLED=false
SCHEDULED_RESEARCH_ENABLED=false

# Flags below match the running Oracle deployment. Each one only matters when the
# matching worker/scheduler is started (see docs/oracle-deployment.md, section 6).
# Macro series ingestion (macro-scheduler + worker-macro); the allowlist limits it to commodity series.
MACRO_INGESTION_ENABLED=true
MACRO_SERIES_ALLOWLIST=WTI_USD_BBL,BRENT_USD_BBL,GLOBAL_GOLD_USD_TROY_OZ,GLOBAL_COAL_AUSTRALIA_USD_MT,GLOBAL_PALM_OIL_USD_MT,GLOBAL_COTTON_USD_KG,GLOBAL_LNG_JAPAN_USD_MMBTU,GLOBAL_COPPER_USD_MT
# Article/PDF discovery, parsing, event classification and company snapshots.
PIPELINE_ENABLED=true
PIPELINE_DISPATCH_SCOPE=
# false = events are classified by keyword rules only; true adds the free model classifier.
PIPELINE_ENRICHMENT_ENABLED=false
EVIDENCE_ENABLED=true
EVIDENCE_MATERIAL_NEWS_ENABLED=true
EVIDENCE_PASS4_BREADTH_ENABLED=true
EVIDENCE_CANARY_STORAGE_DAILY_MB=256
EVIDENCE_CANARY_STORAGE_SEVEN_DAY_MB=1024
# Empty is fail-closed: no source is fetched. These are the audited sources currently enabled.
EVIDENCE_SOURCE_ALLOWLIST=dawn,business_recorder,bbc_world,guardian_world,gcaptain,freightwaves,world_fertilizer,world_cement,oilprice,cotton_grower,mettis,briefing_news,psx_announcements
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_ENDPOINT_URL=http://minio:9000
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=psx-artifacts
ARTIFACT_S3_ACCESS_KEY=replace-with-minio-access-key
ARTIFACT_S3_SECRET_KEY=replace-with-minio-secret-key
ARTIFACT_S3_ADDRESSING_STYLE=path
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key
EVIDENCE_SPOOL_ROOT=/data/evidence-spool
API_INTERNAL_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Persistent Assistant policy; Trial 2 is opt-in, never automatic.
ASSISTANT_TOKEN_TRIAL=trial1
ASSISTANT_QUEUE_TIMEOUT_SECONDS=120
