#!/usr/bin/env bash
set -euo pipefail

compose=(docker compose -f compose.oracle.yml)
pipeline_services=(pipeline-scheduler pipeline-discovery pipeline-fetch pipeline-parse pipeline-enrich pipeline-heavy pipeline-intelligence pipeline-numeric)

usage() {
  echo "Usage: $0 status | run market | start market|phase2|macro|evidence|pipeline | stop market|phase2|macro|evidence|pipeline|all"
}

case "${1:-}" in
  status)
    "${compose[@]}" --profile ingestion --profile scheduling --profile pipeline ps
    ;;
  run)
    [[ "${2:-}" == "market" ]] || { usage; exit 2; }
    "${compose[@]}" run --rm api python -m app.jobs.market_daily --once
    ;;
  start)
    case "${2:-}" in
      pipeline)
        legacy=$("${compose[@]}" --profile ingestion --profile scheduling ps --status running --services | grep -E '^(worker-.*|market-scheduler|phase2-scheduler|evidence-scheduler)$' || true)
        [[ -z "$legacy" ]] || { echo "Stop legacy ingestion producers/workers before starting the pipeline." >&2; exit 1; }
        "${compose[@]}" exec -T api python -c 'from app.core.config import settings; assert settings.pipeline_enabled, "Set PIPELINE_ENABLED=true for the API after migrations and validation"'
        "${compose[@]}" --profile pipeline up -d "${pipeline_services[@]}"
        ;;
      market) "${compose[@]}" --profile scheduling up -d market-scheduler ;;
      phase2) "${compose[@]}" --profile ingestion up -d worker-broad-fundamentals worker-dps-history worker-financial-download worker-extract ;;
      macro) "${compose[@]}" --profile ingestion up -d worker-macro ;;
      evidence) "${compose[@]}" --profile ingestion up -d worker-evidence-discovery worker-evidence-fetch worker-evidence-parse worker-evidence-index worker-historical-hydrate evidence-scheduler ;;
      *) usage; exit 2 ;;
    esac
    ;;
  stop)
    case "${2:-}" in
      pipeline) "${compose[@]}" --profile pipeline stop "${pipeline_services[@]}" pipeline-model ;;
      market) "${compose[@]}" stop market-scheduler ;;
      phase2) "${compose[@]}" stop phase2-scheduler worker-broad-fundamentals worker-dps-history worker-financial-download worker-extract ;;
      macro) "${compose[@]}" stop macro-scheduler worker-macro ;;
      evidence) "${compose[@]}" stop evidence-scheduler worker-evidence-discovery worker-evidence-fetch worker-evidence-parse worker-evidence-pdf worker-evidence-index worker-historical-hydrate ;;
      all) "${compose[@]}" --profile ingestion --profile scheduling --profile pipeline stop "${pipeline_services[@]}" pipeline-model market-scheduler phase2-scheduler macro-scheduler evidence-scheduler worker-broad-fundamentals worker-dps-history worker-financial-download worker-extract worker-macro worker-evidence-discovery worker-evidence-fetch worker-evidence-parse worker-evidence-pdf worker-evidence-index worker-historical-hydrate ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac
